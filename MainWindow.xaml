<Window x:Class="CGWallpaper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyWallpaper"
        Width="940" Height="620"
        MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0C"
        Foreground="#FAFAFA"
        FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Profile Bar with Lucide Icons -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Profil" VerticalAlignment="Center" Foreground="#8E8E93" FontSize="12" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbProfiles" Style="{StaticResource MonoComboBox}" Width="165" MinHeight="32" SelectionChanged="CmbProfiles_SelectionChanged"/>

                <!-- Lucide: plus -->
                <Button x:Name="BtnNewProfile" Style="{StaticResource MonoSecondaryButton}" ToolTip="Nouveau profil" Padding="9,7" Margin="6,0,0,0" Click="BtnNewProfile_Click">
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 5,12 H 19 M 12,5 V 19" Stroke="#FAFAFA" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Lucide: trash-2 -->
                <Button x:Name="BtnDeleteProfile" Style="{StaticResource MonoSecondaryButton}" ToolTip="Supprimer le profil actif" Padding="9,7" Margin="4,0,0,0" Click="BtnDeleteProfile_Click">
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 3,6 H 21 M 19,6 V 20 A 2,2 0 0 1 17,22 H 7 A 2,2 0 0 1 5,20 V 6 M 8,6 V 4 A 2,2 0 0 1 10,2 H 14 A 2,2 0 0 1 16,4 V 6 M 10,11 V 17 M 14,11 V 17" Stroke="#E4E4E7" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Lucide: download (Importer) -->
                <Button x:Name="BtnImportProfile" Style="{StaticResource MonoSecondaryButton}" ToolTip="Importer un profil (.ewp)" Padding="12,7" Margin="0,0,6,0" Click="BtnImportProfile_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 21,15 V 19 A 2,2 0 0 1 19,21 H 5 A 2,2 0 0 1 3,19 V 15 M 7,10 L 12,15 L 17,10 M 12,15 V 3" Stroke="#E4E4E7" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Importer" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Lucide: upload (Exporter) -->
                <Button x:Name="BtnExportProfile" Style="{StaticResource MonoSecondaryButton}" ToolTip="Exporter le profil actif (.ewp)" Padding="12,7" Margin="0,0,6,0" Click="BtnExportProfile_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 21,15 V 19 A 2,2 0 0 1 19,21 H 5 A 2,2 0 0 1 3,19 V 15 M 17,8 L 12,3 L 7,8 M 12,3 V 15" Stroke="#E4E4E7" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Exporter" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Lucide: share-2 (Partager via Windows) -->
                <Button x:Name="BtnShareProfile" Style="{StaticResource MonoSecondaryButton}" ToolTip="Partager via Windows" Padding="12,7" Click="BtnShareProfile_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="15" Canvas.Top="2" Width="6" Height="6" Stroke="#E4E4E7" StrokeThickness="2"/>
                                <Ellipse Canvas.Left="3" Canvas.Top="9" Width="6" Height="6" Stroke="#E4E4E7" StrokeThickness="2"/>
                                <Ellipse Canvas.Left="15" Canvas.Top="16" Width="6" Height="6" Stroke="#E4E4E7" StrokeThickness="2"/>
                                <Path Data="M 8.59,13.51 L 15.42,17.49 M 15.41,6.51 L 8.59,10.49" Stroke="#E4E4E7" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Partager" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Monitor Layout Canvas -->
        <Border Grid.Row="1" Background="#111113" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Canvas x:Name="MonitorCanvas" SizeChanged="MonitorCanvas_SizeChanged"/>
        </Border>

        <!-- Minimalist Bottom Bar -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Sleek Status Pill -->
            <Border x:Name="StatusPill"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#141416"
                    BorderBrush="#27272A"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,7"
                    Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#71717A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus"
                               Text="Cliquez sur un écran ou glissez un média"
                               Foreground="#A1A1AA"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <Button x:Name="BtnRefresh" Grid.Column="1" Style="{StaticResource MonoSecondaryButton}" Content="Actualiser" Margin="0,0,10,0" Click="BtnRefresh_Click"/>
            <Button x:Name="BtnApply" Grid.Column="2" Style="{StaticResource MonoPrimaryButton}" Content="Appliquer" Click="BtnApply_Click"/>
        </Grid>
    </Grid>
</Window>
