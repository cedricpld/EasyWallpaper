<Window x:Class="CGWallpaper.UrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Source en direct"
        Width="520" Height="310"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0B0B0C"
        Foreground="#FAFAFA"
        FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Type de source" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4E7" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="RbWeb" Content="Flux Live (.m3u8) / Page Web / YouTube" IsChecked="True" Foreground="#FAFAFA" Margin="0,0,20,0" Checked="Mode_Changed"/>
            <RadioButton x:Name="RbSnapshot" Content="Image Webcam (JPG/MJPEG)" Foreground="#FAFAFA" Checked="Mode_Changed"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="URL (https://...)" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4E7" Margin="0,0,0,6"/>
        <TextBox x:Name="TxtUrl" Grid.Row="3" Padding="10,7" Background="#18181B" Foreground="#FAFAFA" BorderBrush="#2E2E32" BorderThickness="1" CaretBrush="#FAFAFA" Margin="0,0,0,14"/>

        <StackPanel x:Name="PanelRefresh" Grid.Row="4" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,10">
            <TextBlock Text="Rafraîchissement :" VerticalAlignment="Center" Foreground="#8E8E93" Margin="0,0,10,0"/>
            <ComboBox x:Name="CmbInterval" Style="{StaticResource MonoComboBox}" Width="145" SelectedIndex="1">
                <ComboBoxItem Tag="5" Content="5 secondes"/>
                <ComboBoxItem Tag="10" Content="10 secondes"/>
                <ComboBoxItem Tag="15" Content="15 secondes"/>
                <ComboBoxItem Tag="30" Content="30 secondes"/>
                <ComboBoxItem Tag="60" Content="1 minute"/>
                <ComboBoxItem Tag="300" Content="5 minutes"/>
            </ComboBox>
        </StackPanel>

        <CheckBox x:Name="ChkMute" Grid.Row="4" Content="Couper le son" IsChecked="True" Foreground="#A1A1AA" VerticalAlignment="Center"/>

        <TextBlock Grid.Row="5" Text="Supporte en temps réel les flux HLS (.m3u8), vidéos (.mp4/.webm), YouTube Live et pages web." TextWrapping="Wrap" FontSize="11.5" Foreground="#71717A" VerticalAlignment="Top" Margin="0,8,0,0"/>

        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Button x:Name="BtnDisable" Style="{StaticResource MonoSecondaryButton}" Content="Supprimer" Foreground="#F87171" HorizontalAlignment="Left" Click="BtnDisable_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource MonoSecondaryButton}" Content="Annuler" Margin="0,0,8,0" IsCancel="True"/>
                <Button Style="{StaticResource MonoPrimaryButton}" Content="Valider" IsDefault="True" Click="BtnOk_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
