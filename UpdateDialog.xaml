<Window x:Class="CGWallpaper.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mise à jour disponible"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B0B0C"
        Foreground="#FAFAFA"
        FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="34" Height="34" CornerRadius="8" Background="#141416" BorderBrush="#27272A" BorderThickness="1" Margin="0,0,12,0">
                <Viewbox Margin="5">
                    <Canvas Width="256" Height="256">
                        <Ellipse Canvas.Left="52" Canvas.Top="52" Width="152" Height="152" Stroke="#FAFAFA" StrokeThickness="14"/>
                        <Path Data="M 56,146 C 86,116 122,162 152,128 C 170,108 186,116 200,132" Stroke="#FAFAFA" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M 72,174 C 102,154 140,182 184,162" Stroke="#A1A1AA" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Ellipse Canvas.Left="138" Canvas.Top="72" Width="28" Height="28" Fill="#FAFAFA"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Mise à jour disponible" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA"/>
                <TextBlock x:Name="TxtVersions" Text="v1.0.0 → v1.0.1" FontSize="12" Foreground="#8E8E93" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="Une nouvelle version d'EasyWallpaper est disponible sur GitHub. Voulez-vous la télécharger et l'installer automatiquement ?"
                   TextWrapping="Wrap"
                   FontSize="12.5"
                   Foreground="#D4D4D8"
                   Margin="0,0,0,18"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource MonoSecondaryButton}" Content="Plus tard" Margin="0,0,8,0" IsCancel="True"/>
            <Button Style="{StaticResource MonoPrimaryButton}" Content="Mettre à jour" IsDefault="True" Click="BtnUpdate_Click"/>
        </StackPanel>
    </Grid>
</Window>
