<Window x:Class="CGWallpaper.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau profil"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0B0B0C"
        Foreground="#FAFAFA"
        FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nom du profil" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4E7" Margin="0,0,0,8"/>
        <TextBox x:Name="TxtName" Grid.Row="1" Padding="10,7" Background="#18181B" Foreground="#FAFAFA" BorderBrush="#2E2E32" BorderThickness="1" CaretBrush="#FAFAFA" Margin="0,0,0,18"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource MonoSecondaryButton}" Content="Annuler" Margin="0,0,8,0" IsCancel="True"/>
            <Button Style="{StaticResource MonoPrimaryButton}" Content="Enregistrer" IsDefault="True" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
